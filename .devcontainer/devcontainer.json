{
  "name": "Reachy Mini Workshop",
  // GHCR に公開するまではローカルでビルドする
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "Simulator Viewer", "onAutoForward": "openBrowser" },
    "8000": { "label": "Reachy Mini daemon", "onAutoForward": "silent" }
  },
  "secrets": {
    "OPENAI_API_KEY": { "description": "OpenAI API キー（07〜09, 11〜13 で使用）" }
  },
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": { "python.defaultInterpreterPath": "/opt/venv/bin/python" }
    }
  }
}
